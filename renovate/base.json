{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "schedule:earlyMondays",
        ":semanticCommitTypeAll(chore)",
        ":approveMajorUpdates",
        "helpers:pinGitHubActionDigests"
    ],
    "labels": ["dependencies"],
    "dependencyDashboard": true,
    "rebaseWhen": "conflicted",
    "timezone": "UTC",
    "lockFileMaintenance": {
        "enabled": false
    },
    "env": {
        "CI": "1"
    },
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "rangeStrategy": "bump",
    "postUpdateOptions": ["pnpmDedupe"],
    "minimumReleaseAge": "3 days",
    "packageRules": [
        {
            "description": "disable minimumReleaseAge for @conterra and @open-pioneer packages",
            "matchPackageNames": ["@conterra/**", "@open-pioneer/**"],
            "minimumReleaseAge": null
        },
        {
            "description": "disable minimumReleaseAge for open pioneer github actions",
            "matchManagers": ["github-actions"],
            "matchDepTypes": ["action"],
            "matchDepNames": ["open-pioneer/trails-repo-automation"],
            "minimumReleaseAge": null
        },
        {
            "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
            "matchDepTypes": [
                "dependencies",
                "devDependencies",
                "packageManager",
                "pnpm.catalog.default"
            ],
            "matchCurrentVersion": "!/^0/",
            "groupName": "all non-major dependencies",
            "groupSlug": "all-minor-patch"
        },
        {
            "matchUpdateTypes": ["patch", "pin", "digest"],
            "matchDepTypes": [
                "dependencies",
                "devDependencies",
                "packageManager",
                "pnpm.catalog.default"
            ],
            "matchCurrentVersion": "/^0/",
            "description": "group all non-major dependencies with 0.x versions",
            "groupName": "all non-major dependencies",
            "groupSlug": "all-minor-patch"
        },
        {
            "matchPackageNames": "@open-pioneer/**",
            "matchCurrentVersion": "/-dev/",
            "description": "Disable automatic updates for dev snapshots",
            "enabled": false
        },
        {
            "matchDepTypes": ["engines"],
            "matchUpdateTypes": ["major"],
            "groupName": "update engines",
            "description": "update engines",
            "dependencyDashboardApproval": true
        },
        {
            "description": "disable non-major engine updates",
            "matchDepTypes": ["engines"],
            "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
            "enabled": false
        },
        {
            "description": "disable override updates",
            "matchDepTypes": ["overrides", "pnpm.overrides", "pnpm-workspace.overrides"],
            "enabled": false
        }
    ]
}
