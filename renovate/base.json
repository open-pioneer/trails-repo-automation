{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        "schedule:earlyMondays",
        ":semanticCommitTypeAll(chore)",
        ":approveMajorUpdates",
        "helpers:pinGitHubActionDigests"
    ],
    "labels": ["dependencies"],
    "dependencyDashboard": true,
    "rebaseWhen": "conflicted",
    "timezone": "UTC",
    "lockFileMaintenance": {
        "enabled": false
    },
    "prConcurrentLimit": 0,
    "prHourlyLimit": 0,
    "rangeStrategy": "bump",
    "postUpdateOptions": ["pnpmDedupe"],
    "minimumReleaseAge": "3 days",
    "packageRules": [
        {
            "description": "disable minimumReleaseAge for @conterra and @open-pioneer packages",
            "matchPackageNames": ["@conterra/**", "@open-pioneer/**"],
            "minimumReleaseAge": null
        },
        {
            "description": "don't use digest pinning for our own shared actions",
            "matchManagers": ["github-actions"],
            "matchDepNames": ["open-pioneer/trails-repo-automation"],
            "pinDigests": false,
            "minimumReleaseAge": null
        },
        {
            "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
            "matchDepTypes": [
                "dependencies",
                "devDependencies",
                "packageManager",
                "pnpm.catalog.default"
            ],
            "matchCurrentVersion": "!/^0/",
            "groupName": "all non-major dependencies",
            "groupSlug": "all-minor-patch"
        },
        {
            "matchUpdateTypes": ["patch", "pin", "digest"],
            "matchDepTypes": [
                "dependencies",
                "devDependencies",
                "packageManager",
                "pnpm.catalog.default"
            ],
            "matchCurrentVersion": "/^0/",
            "description": "group all non-major dependencies with 0.x versions",
            "groupName": "all non-major dependencies",
            "groupSlug": "all-minor-patch"
        },
        {
            "matchPackageNames": "@open-pioneer/**",
            "matchCurrentVersion": "/-[a-z][a-z0-9-]*\\.\\d+$/i",
            "description": "For dependencies pinned to a snapshot (e.g. 3.1.1-dev.20260623134110): update to newer snapshot with same tag or to the newer release.",
            "allowedVersions": "/-{{{ replace '\\..*' '' (lookup (split currentVersion '-') 1) }}}\\.|^\\d+\\.\\d+\\.\\d+$/",
            "groupName": "development snapshots",
            "groupSlug": "dev-snapshots"
        },
        {
            "matchDepTypes": ["engines"],
            "matchUpdateTypes": ["major"],
            "groupName": "update engines",
            "description": "update engines",
            "dependencyDashboardApproval": true
        },
        {
            "description": "disable non-major engine updates",
            "matchDepTypes": ["engines"],
            "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
            "enabled": false
        },
        {
            "description": "disable override updates",
            "matchDepTypes": ["overrides", "pnpm.overrides", "pnpm-workspace.overrides"],
            "enabled": false
        }
    ]
}
